# --- Secrets (NEVER commit) ---
.env
.env.*
!.env.example
*.key
*.pem

# --- Python ---
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Logs ---
logs/
*.log
heartbeat.txt

# --- Data / DB / large artifacts (regenerated at runtime) ---
*.db
api-scrip-master.csv
*.csv.gz
# data/ is ~2GB across 5,600+ files and every byte of it is re-fetchable.
# Ignored WHOLESALE rather than per-subdirectory: listing `data/bhavcopy/` and
# `data/events/` individually left any FUTURE cache directory unignored by
# default, so the next harvester to land would have been one `git add -A` away
# from pushing gigabytes. Deny by default, allow by exception.
#   data/bhavcopy/ — NSE UDiFF bhavcopy zips, backtest.bhavcopy.bulk_download
#   data/events/   — board-meeting intimations, backtest.events.download_range
data/*
# Exception: the pre-purge ledger snapshot is EVIDENCE, not a cache. It is the
# state of the trade ledger before the 2026-07-30 synthetic-row purge and cannot
# be regenerated from anything.
!data/ledger_backup_pre_synthetic_purge_2026-07-30.json

# --- Runtime state / control files ---
PANIC_BUTTON.txt
paper_trades_db.json
oi_memory_bank.json

# --- Frontend ---
frontend/node_modules/
frontend/dist/
node_modules/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Local tooling / scratch ---
.claude/settings.local.json
trade_dump.json
