# Trading mode gate: PAPER (default, safe) or LIVE (real orders sent to Dhan).
# Leave as PAPER until you have independently verified the execution layer.
TRADING_MODE=PAPER

# Phase 6 income ladder — switches from the gated 5-8 DTE sniper to weekly
# 30-45 DTE tranches. See README for validation status.
LADDER_MODE=false
TRADING_EQUITY=500000

# Minutes after the 09:15 open during which open positions are NOT evaluated for
# exit. Option books are empty then and quotes are stale prints from the previous
# session; exits priced off them book fabricated P&L. Set 0 to disable.
MARKET_OPEN_WARMUP_MIN=5

DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Database Configuration
DB_NAME=agentic_trader
DB_USER=trader
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Configuration (Get your key from https://console.groq.com/)
GROQ_API_KEY=
